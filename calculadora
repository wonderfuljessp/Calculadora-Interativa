#include <stdio.h>

void IniciarCalculadora(float a, float b, char operacao){
switch(operacao){ 
case '+': 
	printf("%.2f + %.2f = %.2f", a, b, a + b); 
	break;
case '-':
	printf("%.2f - %.2f = %.2f", a, b, a - b);
	break; 
case '*':
	printf("%.2f * %.2f = %.2f", a, b, a * b); 
	break;
case '/':
	if(b != 0){
	printf("%.2f / %.2f = %.2f", a, b, a / b); }
	else{
		printf("Não se pode dividir um numero por zero");
	}
	break;
default:
printf("Insira um operador valido!");
}}
int main(){
	float numero1, numero2;
	char operacao;
	printf("Digite o primeiro numero: ");
	scanf("%f", &numero1);
	printf("Digite o segundo numero: ");
	scanf("%f", &numero2);
	printf("Digite a operacao a ser feita entre eles: ");
	scanf(" %c", &operacao);
	IniciarCalculadora(numero1, numero2, operacao);
}
